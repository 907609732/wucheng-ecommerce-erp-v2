{
  "startUrl": "https://b.cainiao.com/business/dsc/oms/inventory/inventoryreport",
  "timezone": "Asia/Shanghai",
  "downloadDir": "downloads",
  "reportDir": "reports",
  "login": {
    "usernameSelectors": [
      "input[name='loginId']",
      "input[name='username']",
      "input[name='account']",
      "input[type='tel']",
      "input[type='text']"
    ],
    "passwordSelectors": [
      "input[name='password']",
      "input[type='password']"
    ],
    "submitSelectors": [
      "button:has-text('登录')",
      "button:has-text('登 录')",
      "input[type='submit']",
      "button[type='submit']"
    ]
  },
  "downloadSteps": [
    {
      "type": "click",
      "selector": "text=库存明细"
    },
    {
      "type": "wait",
      "ms": 2000
    },
    {
      "type": "click",
      "selector": "button:has-text('查询')"
    },
    {
      "type": "wait",
      "ms": 3000
    },
    {
      "type": "click",
      "selector": "button:has-text('导出明细')"
    },
    {
      "type": "waitForSelector",
      "selector": "button:has-text('下载')",
      "timeout": 120000
    },
    {
      "type": "download",
      "selector": "button:has-text('下载')",
      "timeout": 120000
    }
  ],
  "autoDownload": {
    "enabled": true,
    "navigationTexts": [
      "库存",
      "库存查询",
      "库存管理"
    ],
    "downloadTexts": [
      "导出",
      "下载",
      "导出库存",
      "导出数据"
    ]
  },
  "inventoryColumns": {
    "sku": [
      "SKU",
      "sku",
      "商家编码",
      "商家SKU",
      "货品条码",
      "条码",
      "商品编码",
      "货品编码"
    ],
    "barcode": [
      "商品编码",
      "商品条码",
      "货品条码",
      "条码",
      "货品编码"
    ],
    "name": [
      "商品名称",
      "货品名称",
      "品名",
      "名称"
    ],
    "quantity": [
      "期末库存",
      "当前仓库存",
      "当前仓库存数",
      "菜鸟云仓库存",
      "上海仓库库存",
      "诸暨仓库库存",
      "库存数量",
      "可用库存",
      "库存",
      "数量",
      "可售库存",
      "实物库存"
    ]
  },
  "erp": {
    "defaultLowStockThreshold": 10,
    "warehouses": [
      {
        "id": "cainiao",
        "name": "菜鸟云仓"
      }
    ]
  }
}
