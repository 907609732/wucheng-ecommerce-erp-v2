{
  "name": "wucheng-ecommerce-erp-v2",
  "version": "0.9.2",
  "description": "五成电子商务工作台统一源码与云仓组件",
  "author": "五成电子商务集团",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "launcher": "electron desktop/launcher",
    "launcher:build": "node scripts/build-launcher.mjs",
    "test:modules": "node --test tests/module-manager.test.mjs",
    "test:launcher": "node tests/launcher-ui.mjs && node tests/launcher-loading.mjs",
    "desktop": "electron desktop/launcher",
    "ai:status": "electron desktop/launcher --cli status",
    "ai:doctor": "electron desktop/launcher --cli doctor",
    "ai:send-latest-valid": "electron desktop/launcher --cli send-latest-valid --confirm-send",
    "ai:mcp": "electron desktop/launcher --mcp-stdio",
    "ai:inspect": "mcp-inspector --web --config mcp-inspector.json",
    "ai:inspect:tools": "mcp-inspector --cli --config mcp-inspector.json --server wucheng-ecommerce-erp-v2 --method tools/list --format json --strict",
    "desktop:pack": "node scripts/build-launcher.mjs --dir",
    "desktop:build": "node scripts/build-launcher.mjs",
    "desktop:publish": "node scripts/publish-workbench.mjs",
    "setup": "playwright install chromium",
    "test:login": "node core/playwright-login.js",
    "sync:inventory:local": "node core/sync-cainiao-inventory.js",
    "sync:sales:monthly": "node core/sync-cainiao-monthly-sales.js",
    "sync:sales:backfill": "node core/backfill-cainiao-monthly-sales.js --from 2025-08 --to 2026-07",
    "test:core": "node --test tests/cainiao-export-controls.test.js tests/dingtalk-auth.test.js tests/dingtalk-app-robot.test.js tests/dingtalk-inventory-reminder.test.js tests/inventory-validation.test.js",
    "test:warehouse-sales": "node --test tests/warehouse-monthly-sales.test.js tests/monthly-sales-dashboard.test.js",
    "docs:features": "node scripts/export-feature-help.mjs",
    "test:feature-help": "node --test tests/feature-help-content.test.mjs && node tests/feature-help-ui.mjs",
    "test:desktop": "node --test tests/desktop-settings.test.js tests/desktop-ai-interface.test.js tests/desktop-inventory.test.js tests/desktop-task-process.test.js tests/desktop-remote-service.test.js",
    "workbench:build": "node scripts/build-launcher.mjs",
    "test:workbench-data-move": "node --test tests/local-data-move.test.mjs",
    "warehouse:dev": "electron .",
    "warehouse:build": "node desktop/prepare-build.mjs --channel=release && electron-builder --config build/electron-builder.config.cjs --win nsis"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.1.0",
    "@alicloud/dysmsapi20170525": "4.6.0",
    "@alicloud/dyvmsapi20170525": "4.5.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/reply-from": "12.8.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "axios": "^1.20.0",
    "cron-parser": "5.10.2",
    "dingtalk-stream": "^2.1.5",
    "dotenv": "^16.4.7",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "fastify": "^5.12.5",
    "gridjs": "^6.2.0",
    "nodemailer": "10.2.1",
    "playwright": "^1.49.1",
    "semver": "7.7.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/inspector": "^2.8.0",
    "@playwright/test": "^1.61.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "yazl": "3.3.1"
  }
}
