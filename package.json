{
  "name": "wucheng-ecommerce-erp-v2",
  "version": "0.14.3",
  "description": "五成 ERP 浏览器服务：采购、销售、经营总览",
  "author": "五成电子商务集团",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/cli.mjs dev",
    "web:dev": "node server/cli.mjs dev",
    "web:start": "node server/cli.mjs start",
    "web:check": "node server/cli.mjs check",
    "web:status": "node server/cli.mjs status",
    "web:stop": "node server/cli.mjs stop",
    "web:backup": "node server/cli.mjs backup",
    "web:update": "node server/cli.mjs update",
    "web:collector": "node server/collector.mjs",
    "start": "node server/cli.mjs start",
    "test": "node --test --test-concurrency=2 tests/web-*.test.mjs",
    "test:purchase": "npm --prefix apps/purchase test",
    "test:sales": "npm --prefix apps/sales test",
    "test:overview": "npm --prefix apps/overview test",
    "check": "node server/cli.mjs check",
    "sync:approval": "node scripts/sync-agent-approval.mjs --check",
    "sync:loading": "node scripts/sync-loading-assets.mjs",
    "sync:ui": "node scripts/sync-ui-assets.mjs",
    "check:ui": "node scripts/sync-ui-assets.mjs --check"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "@fastify/cookie": "11.1.3",
    "@fastify/reply-from": "12.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  }
}
