#!/bin/sh
set -eu
SELF=$(CDPATH= cd -P "$(dirname "$0")" && pwd -P)
. "$SELF/diag_env"
prepare_diag
# Root may prepare only the exact physical app base. Re-enter this fixed trusted
# cmd script synchronously as the package user before reading/writing any marker
# or run/evidence file in the package-owned tree. No payload code runs as root.
if [ "$(id -u)" = 0 ]; then
 as_package /bin/sh "$SELF/acceptance" "$@"
 exit 0
fi
[ ! -L "$BASE/active-run" ] || fail '诊断运行标记不能是符号链接；请先检查独立诊断目录。'
command -v flock >/dev/null 2>&1 || fail '诊断需要系统 util-linux flock。'
[ ! -L "$BASE/acceptance.lock" ] || fail '诊断作业锁不能是符号链接。'
exec 9>>"$BASE/acceptance.lock"
flock -n 9 || fail '已有诊断作业，先停止当前作业再重试。'
stop_diag
run="run-$(date -u +%Y%m%dT%H%M%SZ)-$$"
RUN="$BASE/$run"
mkdir -m700 "$RUN"
status=0
limit=${1:-240}
case "$limit" in ''|*[!0-9]*) fail '诊断时间限制必须为 1–240 秒。';; esac
[ "$limit" -ge 1 ] && [ "$limit" -le 240 ] || fail '诊断时间限制必须为 1–240 秒。'
mkdir -m700 "$RUN/evidence"
printf '%s\n' "$run" > "$BASE/.active-run-$$"
mv -f "$BASE/.active-run-$$" "$BASE/active-run"
# The real root recovery helper requires these trusted system stdlib modules.
# Inspect before starting any native process; python-minimal alone may lack them.
if ! timeout --signal=TERM --kill-after=2s 10s env -u LD_LIBRARY_PATH -u LD_PRELOAD /usr/bin/python3 -I -B -c 'import sqlite3,ctypes,fcntl,json,sys; print(json.dumps({"ok":True,"version":sys.version,"sqlite":sqlite3.sqlite_version}))' > "$RUN/evidence/system-python.log" 2>&1; then
 printf '%s\n' '{"ok":false,"cleanupComplete":true,"successfulStarts":0,"stage":"system-python-preflight","error":"Trusted /usr/bin/python3 needs sqlite3,ctypes,fcntl,json; ask administrator to prepare official system Python; no native service started"}' > "$RUN/evidence/acceptance.json"
 fail "系统 Python 标准库预检失败，未启动原生进程；请管理员核对官方 python3 完整环境。证据：$RUN/evidence"
fi
if [ -e "$RUN/cancel-request" ]; then
 printf '%s\n' '{"ok":false,"cleanupComplete":true,"successfulStarts":0,"cancelReason":"external-stop","error":"Diagnostic cancelled before native startup"}' > "$RUN/evidence/acceptance.json"
 fail '诊断已由外部停止，未启动原生进程。'
fi
# timeout is itself unprivileged. TERM allows nativeLifecycle/finally cleanup;
# after any timeout a second identity-checked native stop is always attempted.
as_package timeout --signal=TERM --kill-after=45s "${limit}s" "$NODE" "$PAYLOAD/smoke-native.mjs" --app-root "$PAYLOAD" --data-root "$RUN/data" --evidence-dir "$RUN/evidence" --port-offset 10000 --diagnostic 1 --cancel-file "$RUN/cancel-request" || status=$?
stop_diag || status=1
printf '%s\n' "诊断结果：$RUN/evidence/acceptance.json；作业已结束，诊断应用保持停止。"
[ "$status" = 0 ] || fail "原生诊断失败或超时（$status），保留证据：$RUN/evidence；正式应用未操作。"
