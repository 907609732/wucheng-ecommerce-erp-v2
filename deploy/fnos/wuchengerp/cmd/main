#!/bin/sh
set -eu
SELF=$(CDPATH= cd -P "$(dirname "$0")" && pwd -P)
. "$SELF/native_env"
case "${1:-}" in
 start|status|stop) ACTION=$1;;
 *) fail 'Supported actions: start, stop, status.';;
esac
if [ ! -f "$CONFIG" ]; then
 case "$ACTION" in stop) exit 0;; status) exit 3;; *) fail 'ERP 尚未初始化，请选择新建或已校验的停写副本。';; esac
fi
resolve_payload "$ACTION"
if [ ! -x "$NODE" ] || [ ! -f "$LIFECYCLE" ]; then
 [ "$ACTION" != status ] || exit 3
 fail 'ERP 原生运行文件不完整，请重新安装完整 FPK。'
fi
if [ "$ACTION" = start ]; then prepare_runtime; fi
if as_package "$NODE" "$LIFECYCLE" "$ACTION" --config "$CONFIG"; then exit 0; else
 [ "$ACTION" != status ] || exit 3
 fail "ERP 启停失败，请检查应用 VAR/runtime/logs/native-supervisor.log（旧配置为持久目录 state/native-supervisor.log）。"
fi
